<?xml version="1.0"?>
<!-- Plano texturizado 170x230 mm. Origen = centro del tablero; textura con la parte superior
     del dibujo hacia +y del modelo y la derecha hacia +x (verificado por detección). -->
<sdf version="1.9">
  <model name="charuco_board">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <plane><normal>0 0 1</normal><size>0.170 0.230</size></plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://charuco_board/materials/textures/charuco.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
